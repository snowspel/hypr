#!/bin/bash
# Blurs the image from ~/.config/hypr/wallpaper and puts it into the SDDM theme
dir="__HOME__/.config/hypr/wallpaper"
theme="/usr/share/sddm/themes/snow"
shopt -s nullglob nocaseglob
files=("$dir"/*.{jpg,jpeg,png,webp})
[ ${#files[@]} -gt 0 ] || exit 0
sleep 1   # time for the copy to finish
f=$(ls -t "${files[@]}" | head -1)
tmp=$(mktemp --suffix=.jpg)
convert "$f" -resize 2560x1440^ -gravity center -extent 2560x1440 \
  -blur 0x24 -brightness-contrast -8x0 -modulate 100,90 "$tmp" || { rm -f "$tmp"; exit 1; }
install -m 644 "$tmp" "$theme/background.jpg"
rm -f "$tmp"
